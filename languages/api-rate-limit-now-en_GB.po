#. Plugin Name of the plugin
#: api-rate-limit-now.php
msgid "API Rate Limiter"
msgstr "API Rate Limiter"

#. Description of the plugin
#: api-rate-limit-now.php
msgid "Rate-limit REST API calls by client IP address."
msgstr "Rate-limit REST API calls by client IP address."

#. Author of the plugin
#: api-rate-limit-now.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
#: api-rate-limit-now.php
